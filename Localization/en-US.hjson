		Configs: {
			XenonConfig: {
				DisplayName: Xenon Config

				RequirePreviousOreTierForNext: {
					Label: Ore Tier Crafting Tweak
					Tooltip:
						'''
						Makes each ore armor, weapon, and most tools require the previous tier to craft
						Also reduces the number of bars of that tier required to craft the next item
						(Only effects Pre-Hardmode Items as of right now! keep that in mind)
						'''
				}

				PickaxeRequiredForNextOreTier: {
					Label: Require Previous Tier Pickaxe For Ores
					Tooltip: Makes Silver-tier and Gold-tier ores require the previous tier pickaxe to mine
				}

				HellstoneRename: {
					Label: Hellstone Rename
					Tooltip: Makes it so Hellstone items are renamed to Vulcanite for extra flavor. Name credited to Lune
				}
			}
		}

