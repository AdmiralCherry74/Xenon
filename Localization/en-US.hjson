		SetBonuses: {
			OneDefense: 1 defense
			ThreeDefense: 3 defense
			FourDefense: 4 defense
			CloudArmor: 4% magic critical strike chance, increases your max numbers of minions by 1, and 1% increased magic and summon damage
			Caustic: Increases knockback velocity
		}

		AltBiomes: {
			CorrosionAltBiome: {
				DisplayName: Corrosion
				Description: a Gastric hunger of the corrosion is guaranteed to be present in your world.
				GenPassName: Making the world hungry
				DryadTextDescriptor: corroded
			}
		}

		Tooltips.FossilizedBlessing:
			'''
			Provides 7 seconds of immunity to lava
			Double tap {0} to activate fossilized blessing
			Increases defense and life regeneration by 7 but you cannot move
			'''

		Generation: {
			Mountains: Extruding mountains
			Rhyolite: Erupting rhyolite
			Quicksand: Sinking quicksand
			Ice: Freezing lava
			Corrosion.Message: Making the world hungry
		}

		DeathText: {
			QS_Suffocated_1: "{0} suffocated in quicksand."
			QS_Suffocated_2: "{0} drowned in quicksand."
			QS_Suffocated_3: "{0} discovered the floor was unstable."
			Iceburn_1: "{0} experienced what it feels like to drink liquid nitrogen."
			Iceburn_2: "{0} went up in icy flames."
		}

