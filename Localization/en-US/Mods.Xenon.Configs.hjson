XenonConfig: {
	DisplayName: Xenon Config

	Headers: {
		Gameplay: Gameplay
		Miscellaneous: Miscellaneous
	}

	HellstoneRename: {
		Tooltip:
			'''
			Renames Hellstone and all related gear to Vulcanite.
			Leave this off if you prefer the original name.
			'''
		Label: Hellstone Renames
	}

	RequirePreviousOreTierForNext: {
		Tooltip:
			'''
			Reworks the progression of pre-Hardmode ores, requiring other gear sets to be made with the previous.
			Will be updated for hardmode when hardmode update comes out
			Leave this off if you prefer vanilla's ore crafting progression.
			'''
		Label: Other Ores Require Previous Ores
	}

	MountainGenerationConfigEnabler: {
		Label: Mountain Generation
		Tooltip:
			'''
			Makes it so The Mountains can be generated
			Its a work in progress biome. Sometimes can crash you or not generate.
			'''
	}

	BasicProgressionChanges: {
		Label: Basic Progression Changes
		Tooltip: ""
	}

	BasicGameplayChanges: {
		Label: Basic Gameplay Changes
		Tooltip:
			'''
			Houses all of Xenon's basic gameplay changes. Like Wooden Tools replacing the starting copper tools, Pre-Hardmode Ores following pickaxe progression, drills being reworked to be extremely fast, recipes being changed up and small progression changes
			If you would like to see every change made, check Xenon's github and find the "BasicGameplayChangesList.txt" file
			Disable this if you want a more vanilla playthrough
			'''
	}

	MasterModeChanges: {
		Label: Master Mode Changes
		Tooltip:
			'''
			Houses all of Xenon's master mode changes. Like enemies scaling differently (Enemies are less tanky but more deadly)
			If you would like to see every change made, check Xenon's github and find the "MasterModeChangesList.txt" file
			Disable this if you want a normal vanilla master mode playthrough
			Work In Progress!
			'''
	}
}

XenonClientConfig: {
	DisplayName: Xenon Client Config
	Headers.Miscellaneous: Miscellaneous

	HellstoneRename: {
		Label: Hellstone Renamed To Vulcanite
		Tooltip:
			'''
			Renames Hellstone and all related gear to Vulcanite.
			Leave this off if you prefer the original name.
			'''
	}

	FancyRenames: {
		Label: Fancy Renames
		Tooltip:
			'''
			Renames certain items to fancier renames. Like Purple Ice into Evil Ice
			Some Items will always remain renamed but will be changed for another if enabled. Like Purple Solution being Corruption Solution if off, or Evil Solution if on
			'''
	}
}
